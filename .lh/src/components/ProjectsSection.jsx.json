            "content": "import { motion } from \"framer-motion\";\nimport { projects } from \"../data/data\";\nimport ProjectCard from \"./ProjectCard\";\n\nexport default function ProjectsSection() {\n  return (\n    <>\n      <div className=\"h-40 bg-section-fade\" />\n\n      <section\n        id=\"projects\"\n        className=\"relative bg-darkBg px-4 py-24 sm:px-6 lg:px-10\"\n      >\n        <div className=\"mx-auto max-w-7xl\">\n          <motion.div\n            initial={{ opacity: 0, y: 24 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true, amount: 0.3 }}\n            transition={{ duration: 0.8 }}\n            className=\"mb-14 text-center\"\n          >\n            <h2 className=\"text-4xl font-semibold tracking-tight text-white sm:text-5xl\">\n              Projects\n            </h2>\n            <p className=\"mx-auto mt-4 max-w-2xl text-sm leading-7 text-darkTextMuted sm:text-base\">\n              A curated selection of interfaces, systems, and digital product\n              experiences designed with clarity, depth, and premium detail.\n            </p>\n          </motion.div>\n\n          <div className=\"grid auto-rows-[220px] grid-cols-1 gap-6 md:grid-cols-3\">\n            {projects.map((project, index) => (\n              <motion.div\n                key={project.id}\n                initial={{ opacity: 0, y: 24 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true, amount: 0.2 }}\n                transition={{ duration: 0.6, delay: index * 0.05 }}\n              >\n                <ProjectCard project={project} />\n              </motion.div>\n            ))}\n          </div>\n        </div>\n      </section>\n    </>\n  );\n}"
